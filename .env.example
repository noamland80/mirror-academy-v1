# ---------------------------------------------------------------------------
# MIRROR Academy — environment
# ---------------------------------------------------------------------------

PORT=5000
MIRROR_DB=./data/mirror.db

# demo  : local evaluation. Seeds the Wild Magic demo accounts with the demo
#         passwords. Holds no real client data. This is the default.
# hosted: any instance a paying clinic can reach. Every seed password below
#         becomes mandatory, must be >= 16 characters, and must not be one of
#         the three passwords published to the public repository in the frozen
#         RC mirror-wow-v1-20260901. Boot aborts otherwise, and the server
#         re-proves at startup that no burned credential opens an account.
MIRROR_MODE=demo

# Required when MIRROR_MODE=hosted. Generate fresh values; never reuse the
# Mirror2026!* strings — they are permanently burned and are refused by code.
#   openssl rand -base64 24
MIRROR_SEED_PW_PRAC1=
MIRROR_SEED_PW_PRAC2=
MIRROR_SEED_PW_MGR=
